{
  "name": "observing-super-agent",
  "version": "0.1.0",
  "private": true,
  "description": "An observing super-agent that monitors work-tracking tools and dispatches work to commodity AI agents.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsgo --noEmit",
    "check": "tsx scripts/check-connectivity.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "foundry-local-sdk": "^1.2.3",
    "hono": "^4.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "latest",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  }
}
